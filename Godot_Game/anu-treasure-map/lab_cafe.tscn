[gd_scene load_steps=4 format=3 uid="uid://b2yljyqmhlkja"]

[ext_resource type="Texture2D" uid="uid://1ckfbq840opf" path="res://resources/Location/Lab_Cafe.png" id="1_l2pld"]

[sub_resource type="GDScript" id="GDScript_ugupr"]
script/source = "extends Control

@export var map_scene_path: String = \"res://Map.tscn\"

@onready var back_button: Button = $BackButton
@onready var description: Label = $Description
@onready var event_panel: Control = $EventPanel

var texts: Array[String] = [
	\"This is Lab Cafe.\",
	\"The wind is mild and the sunshine is bright.\",
	\"It feels like a peaceful place to stop for a while.\"
]

var text_index: int = 0
var text_finished: bool = false

func _ready() -> void:
	back_button.pressed.connect(_on_back_button_pressed)
	_show_current_text()

func _on_back_button_pressed() -> void:
	get_tree().change_scene_to_file(map_scene_path)

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton \\
	and event.button_index == MOUSE_BUTTON_LEFT \\
	and event.pressed:
		_show_next_text()

func _show_current_text() -> void:
	if text_index >= 0 and text_index < texts.size():
		description.text = texts[text_index]

func _show_next_text() -> void:
	if text_finished:
		return

	if text_index < texts.size() - 1:
		text_index += 1
		_show_current_text()
	else:
		text_finished = true
		description.hide()
		event_panel.hide()
"

