theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
text = "Press ESC to close"
horizontal_alignment = 1
vertical_alignment = 2
mouse_filter = 2

[connection signal="pressed" from="MapControl/EventPanel/CloseButton" to="MapControl/EventPanel" method="_on_close_button_pressed"]
